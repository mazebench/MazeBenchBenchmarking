{
  "name": "mazebench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start:recovery": "node benchmarking/recovery-server.mjs",
    "start:vision-providers": "node benchmarking/vision-providers/server.mjs",
    "start:playback": "node benchmarking/playback-server.mjs",
    "start:vision": "node --import ./benchmarking/codex-releases.mjs benchmarking/vision/server.mjs",
    "start:capabilities": "node benchmarking/capability-server.mjs",
    "setup:kimi": "python3 scripts/setup-kimi.py",
    "check:kimi": "node scripts/check-kimi.mjs",
    "setup:code-sandbox": "docker build -t mazebench-code:v1 benchmarking/code",
    "test:code-sandbox": "MAZEBENCH_TEST_CODE_SANDBOX=1 node --test tests/benchmark-code.test.mjs",
    "build:physics": "sh scripts/build-physics.sh",
    "test:physics": "sh scripts/test-physics.sh",
    "test:physics:sanitize": "sh scripts/test-physics-sanitize.sh",
    "benchmark:physics": "sh scripts/benchmark-physics.sh",
    "benchmark:search": "sh scripts/benchmark-search.sh",
    "benchmark:search:wasm": "npm run build:physics && node engine/benchmarks/wasm_search_benchmark.mjs",
    "benchmark:evolution": "node apps/web/benchmarks/evolution_generation_benchmark.mjs",
    "migrate:project-data": "node scripts/migrate-project-data.mjs",
    "migrate:tag-groups": "node scripts/migrate-tag-groups.mjs",
    "dev": "npm run dev:lab",
    "predev:lab": "npm run build:physics",
    "dev:lab": "cd apps/web && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3001",
    "dev:site": "node server.mjs",
    "prebuild:lab": "npm run build:physics",
    "build:lab": "cd apps/web && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:solvers": "sh scripts/build-random-agent-v1.sh && sh scripts/build-editor-solver-v1.sh && sh scripts/build-editor-solver-v1.sh solutions",
    "build": "npm run build:lab && npm run build:solvers",
    "start": "node server.mjs",
    "start:lab": "cd apps/web && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --port 3001",
    "test": "npm run test:physics && npm run build && npm run test:js",
    "test:js": "node --test apps/web/tests/*.test.mjs engine/tests/*.test.mjs tests/*.test.mjs",
    "test:lab": "npm run test:physics && npm run build:lab && node --test apps/web/tests/*.test.mjs engine/tests/*.test.mjs",
    "test:site": "node --test tests/*.test.mjs",
    "test:parity": "node --test tests/monorepo-parity.test.mjs tests/rendering-parity.test.mjs",
    "lint": "cd apps/web && eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "cd apps/web && drizzle-kit generate",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "check:engine-snapshot": "node scripts/sync-engine-v1.mjs --check",
    "test:quick": "node scripts/test-quick.mjs",
    "test:integration": "node --test tests/vision-mode.test.mjs tests/vision-wire.test.mjs tests/ice-maze.test.mjs",
    "start:catalogs": "node benchmarking/catalog-server.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.184.0",
    "undici": "6.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@ziglang/cli": "^0.0.14",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "mazebench-playwright": "npm:playwright@1.62.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
